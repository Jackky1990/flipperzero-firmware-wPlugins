ASTRAEON_DEMO_USB_CDC = 0
ASTRAEON_DEMO_CDEFINES = [
    f"ASTRA_RUNTIME_ENABLE_USB_CDC={ASTRAEON_DEMO_USB_CDC}",
]

App(
    appid="astraeon_demo",
    name="ASTRAEON Demo",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="astraeon_demo_main",
    stack_size=2 * 1024,
    fap_category="Tools",
    fap_author="Jack",
    fap_version="0.1",
    fap_description="ASTRAEON-X runtime demo application.",
    sources=[
        "astraeon_demo.c",
        "view.c",
        "input.c",
        "runtime_bootstrap.c",
        "runtime_controller.c",
        "storage_adapter.c",
        "application/application.c",
        "screen/screen_manager.c",
    ],
    fap_private_libs=[
        Lib(
            name="astraeon_sdk",
            fap_include_paths=["include", "src"],
            cdefines=ASTRAEON_DEMO_CDEFINES,
            sources=[
                "src/astra_status.c",
                "src/astra_result.c",
                "src/astra_types.c",
                "src/astra_device_serial.c",
                "src/astra_device_gpio.c",
                "src/astra_flipper_gpio_adapter.c",
                "src/astra_flipper_serial_adapter.c",
                "src/astra_event.c",
                "src/astra_event_types.c",
                "src/astra_event_builder.c",
                "src/astra_runtime_transport.c",
                "src/astra_runtime_usb_transport.c",
                "src/astra_runtime_loopback.c",
                "src/astra_runtime_ping.c",
                "src/astra_runtime_codec.c",
                "src/astra_runtime_message.c",
                "src/astra_runtime_capabilities.c",
                "src/astra_runtime_handshake.c",
                "src/astra_runtime_heartbeat.c",
                "src/astra_policy.c",
                "src/astra_storage.c",
                "src/astra_logger.c",
                "src/astra_event_persistence.c",
                "src/astra_node01.c",
                "src/astra_node01_usb_bridge.c",
            ],
        ),
    ],
    cdefines=ASTRAEON_DEMO_CDEFINES,
)
