App(
    appid="astraeon_demo",
    name="ASTRAEON Demo",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="astraeon_demo_main",
    stack_size=2 * 1024,
    fap_category="Tools",
    fap_author="Jack",
    fap_version="0.1",
    fap_description="ASTRAEON-X runtime demo application.",
    fap_include_paths=["context"],
    sources=["astraeon_demo.c", "view.c", "input.c", "runtime_bootstrap.c"],
    fap_private_libs=[
        Lib(
            name="astraeon_sdk",
            fap_include_paths=["include"],
            sources=[
                "src/astra_result.c",
                "src/astra_runtime_transport.c",
                "src/astra_runtime_loopback.c",
                "src/astra_runtime_ping.c",
                "src/astra_runtime_codec.c",
                "src/astra_runtime_message.c",
            ],
        ),
    ],
)
